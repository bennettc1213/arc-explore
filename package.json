{
  "name": "instela",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:audit": "tsx scripts/db-audit.ts",
    "ingest:fast": "tsx scripts/ingest-fast.ts",
    "ingest:daily": "tsx scripts/ingest-daily.ts",
    "ingest:scholarships": "tsx scripts/ingest-scholarships.ts",
    "ingest:usajobs": "tsx scripts/ingest-usajobs.ts",
    "reminders": "tsx scripts/send-reminders.ts",
    "alerts": "tsx scripts/send-search-alerts.ts",
    "digest": "tsx scripts/send-digest.ts",
    "metrics": "tsx scripts/metrics.ts",
    "ingest:status": "tsx scripts/ingest-status.ts",
    "check:links": "tsx scripts/check-links.ts",
    "ingest:rederive": "tsx scripts/ingest-rederive.ts",
    "ingest:retag": "tsx scripts/backfill-content-marketing.ts",
    "build:mark": "tsx scripts/build-mark.ts",
    "build:extension": "tsc src/lib/apply/autofill.ts src/lib/apply/apply-url.ts src/lib/apply/submitted.ts src/lib/apply/frame-headers.ts --outDir extension/vendor --module es2020 --target es2020 --moduleResolution bundler && node scripts/fix-extension-imports.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "feed:turnover": "tsx scripts/feed-turnover.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
