# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP session artifacts (snapshots, console logs, screenshots)
.playwright-mcp/

# Extension: compiled from src/lib/apply/*.ts by `npm run build:extension`.
# Generated, never edited by hand — a committed copy is a second definition
# of the autofill rules waiting to drift from the tested one.
extension/vendor/

.vercel
